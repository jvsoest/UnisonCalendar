{
  "name": "unison-calendar",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first desktop calendar for CalDAV, Google Calendar and Exchange ActiveSync",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --universal --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "lucide-react": "0.468.0",
    "ical.js": "2.2.1",
    "fast-xml-parser": "5.2.5"
    ,"@mvrx/wbxml": "0.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.3.4",
    "vite": "6.0.11",
    "typescript": "5.7.3",
    "concurrently": "9.1.2",
    "electron": "34.0.2",
    "electron-builder": "25.1.8",
    "wait-on": "8.0.2"
  },
  "build": {
    "appId": "com.unison.calendar",
    "productName": "Unison Calendar",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["universal"] }]
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "category": "Office",
      "maintainer": "Johan van Soest <unison-calendar@johanvansoest.nl>",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    }
  }
}
